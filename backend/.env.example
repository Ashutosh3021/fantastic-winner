# CodeMentor API - configuration
#
# Copy to .env and fill it in. Only PYRONITES_URL, PYRONITES_KEY and one AI
# provider key are needed to run; every other value below is a working
# default, listed so the limit it controls is discoverable instead of buried
# in code.
#
# NEVER commit a filled-in .env. It is already in .gitignore.

# --- runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CLIENT_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://pmkgnbafanjpmmhphckgglhnpajpepal
TRUSTED_PROXY_COUNT=0

# --- datastore ---
PYRONITES_URL=http://localhost:8000
# PYRONITES_KEY=            <- required in production
PYRONITES_PROJECT=codementor
PYRONITES_TIMEOUT_S=30.0
PYRONITES_AUTO_MIGRATE=true

# --- auth ---
AUTH_ACCESS_TTL_S=900
AUTH_REFRESH_TTL_S=2592000
AUTH_LOGIN_CODE_TTL_S=120
REQUIRE_VERIFIED_EMAIL_FOR_AI=true
AUTH_AUTO_VERIFY_DEV=false
# Must contain the extension origin, or every sign-in is rejected with
# "That sign-in link is not valid". Run with no id via:
#   chrome://extensions -> your extension -> Copy ID
EXTENSION_RETURN_ORIGINS=chrome-extension://pmkgnbafanjpmmhphckgglhnpajpepal

# --- credits ---
CREDITS_PER_WINDOW=12
WINDOW_HOURS=5
MAX_ACTIVE_SESSIONS=3
MIN_PLAN_QUESTIONS=3
MAX_PLAN_QUESTIONS=5
QUESTION_ATTEMPT_CAP=8

# --- rate limits ---
RL_LIGHT_CAPACITY=30
RL_LIGHT_PER_MIN=30
RL_HEAVY_CAPACITY=6
RL_HEAVY_PER_MIN=6
RL_CHECK_CAPACITY=20
RL_CHECK_PER_MIN=20
RL_ANALYSIS_CAPACITY=4
RL_ANALYSIS_PER_MIN=4
RL_AUTH_CAPACITY=10
RL_AUTH_PER_MIN=10

# --- ai budgets ---
DAILY_AI_SPEND_CAP_USD=0.0
SPEND_ALERT_FRACTION=0.8
DEGRADED_MODE=false
IP_AI_CALLS_PER_5MIN=40
IP_AI_TOKENS_PER_WINDOW=400000
IP_AI_CALLS_PER_DAY=400
USER_AI_TOKEN_BUDGET_PER_WINDOW=150000
NEW_ACCOUNT_RAMP_HOURS=24
NEW_ACCOUNT_TOKEN_MULTIPLIER=2
NEW_ACCOUNT_TOKEN_BUDGET=50000
ANALYSIS_CAP_PER_SESSION=4
ANALYSIS_CAP_PER_PROBLEM=40

# --- ai gateway ---
OPS_BUDGET_PER_SECOND=100000000
ALLOW_OFFLINE_PROVIDER=false
AI_CONCURRENCY_INTERACTIVE=8
AI_CONCURRENCY_GENERATION=4
AI_CONCURRENCY_ANALYSIS=3
AI_QUEUE_TIMEOUT_S=8.0
AI_MAX_ATTEMPTS=2
AI_BACKOFF_BASE_S=0.5
AI_BACKOFF_CAP_S=8.0
AI_BREAKER_FAILURES=5
AI_BREAKER_WINDOW_S=30.0
AI_BREAKER_OPEN_S=60.0
AI_COST_PER_MTOK_IN=0.15
AI_COST_PER_MTOK_OUT=0.6
# AI_OPENAI_KEY=            <- required in production
# AI_GEMINI_KEY=            <- required in production
# AI_ANTHROPIC_KEY=            <- required in production

# --- bring your own key (BYOK) ---
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to disable the /account/ai-key routes; the app still starts.
BYOK_ENCRYPTION_KEY=
BYOK_MAX_CACHED_PROVIDERS=64

# --- cache ---
CACHE_TTL_DAYS=30
NEGATIVE_CACHE_TTL_S=600
MAX_CACHE_ROWS_PER_SLUG=12
CACHE_FILL_BUCKET_PER_MIN=30

# --- providers ---
ENABLED_LANGUAGES=en
# OPENAI_API_KEY=            <- required in production
# GEMINI_API_KEY=            <- required in production
# ANTHROPIC_API_KEY=            <- required in production
