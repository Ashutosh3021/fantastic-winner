{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "baseUrl": "."
  },
  "include": [
    "entrypoints/**/*",
    "src/**/*",
    "tests/**/*",
    "vitest.config.ts",
    "wxt.config.ts",
    ".wxt/**/*"
  ],
  "exclude": ["node_modules", ".output", ".wxt/types"]
}