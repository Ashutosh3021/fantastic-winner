# Backend origin. No trailing slash. Staged builds point this at staging.
VITE_API_BASE_URL=https://api.codementor.example

# Login flow: "hosted" (backend page + one-time code) or "webext" (OAuth via
# chrome.identity, which adds the `identity` permission).
VITE_AUTH_FLOW=hosted

# Where `chrome.identity.launchWebAuthFlow` should return to, when using webext.
VITE_OAUTH_REDIRECT_URL=https://api.codementor.example/auth/extension/callback